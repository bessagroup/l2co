    given-names: "Martin P."
    email: "m.p.vanderschelling@tudelft.nl"
license: BSD-3-Clause
repository-code: "https://github.com/bessagroup/l2co"
version: "1.3.1"
type: software
keywords:
  - optimization
  - meta-learning
  - jax
  - equinox
  - learning-to-optimize
